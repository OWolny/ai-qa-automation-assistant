# Environment variables for web-e2e.
# Export them in your shell before running tests. All are optional.

# Target application. Defaults to https://practice.expandtesting.com when unset.
BASE_URL=

# Set to 1 to add the WebKit project (requires WebKit host dependencies).
PW_INCLUDE_WEBKIT=

# Set to 1 to add the `agent-seed` project used by the Playwright Test Agents MCP server.
# Leave unset for regular runs.
PW_AGENT_SEED=

# Testomat.io project reporting key. When set, results are also reported to Testomat.io.
# Keep the real value in the git-ignored .env (read by `npm run test:testomat`) or a CI secret.
TESTOMATIO=
